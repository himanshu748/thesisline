# Convex CLI writes the selected deployment to your ignored .env.local.
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Backend secrets belong in Convex environment settings, never in VITE_* variables.
# FIRECRAWL_API_KEY, AI_GATEWAY_API_KEY, AGENTMAIL_API_KEY, AGENTMAIL_INBOX_ID
# JWT_PRIVATE_KEY, JWKS, SITE_URL: see scripts/configure-auth.mjs.
